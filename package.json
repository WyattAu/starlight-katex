{
  "name": "@wyatt/starlight-katex",
  "version": "0.1.0",
  "description": "Starlight plugin for KaTeX math rendering with MDX compatibility",
  "author": "WyattAu",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WyattAu/starlight-katex.git"
  },
  "bugs": {
    "url": "https://github.com/WyattAu/starlight-katex/issues"
  },
  "homepage": "https://github.com/WyattAu/starlight-katex#readme",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles/katex-dark.css": "./styles/katex-dark.css"
  },
  "files": [
    "src/",
    "styles/"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18.17.1"
  },
  "keywords": [
    "starlight-plugin",
    "astro-integration",
    "katex",
    "math",
    "latex",
    "mdx",
    "math-rendering",
    "successor"
  ],
  "dependencies": {
    "remark-math": "^6.0.0",
    "rehype-katex": "^7.0.0",
    "unist-util-visit": "^5.0.0"
  },
  "peerDependencies": {
    "katex": ">=0.16.0",
    "@astrojs/starlight": ">=0.30.0",
    "astro": ">=5.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "@astrojs/starlight": "^0.34.0",
    "astro": "^5.0.0",
    "unified": "^11.0.0",
    "remark-parse": "^11.0.0",
    "rehype-stringify": "^10.0.0",
    "remark-rehype": "^11.0.0",
    "katex": "^0.16.0",
    "mdast-util-from-markdown": "^2.0.0",
    "mdast-util-math": "^3.0.0",
    "micromark-extension-math": "^3.0.0",
    "@types/unist": "^3.0.0"
  }
}
